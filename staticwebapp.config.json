{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.{css,js,svg,png,jpg,jpeg,ico,json,map,txt}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "routes": [
    {
      "route": "/api/marketplace/webhook",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/marketplace/landing",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/marketplace/activate",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    }
  ],
 
}
