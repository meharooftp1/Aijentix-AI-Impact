# Copy to .env.local and set the actual ASP.NET Core HTTPS port if it differs.
VITE_API_PROXY_TARGET=https://localhost:7001

# Optional for a separately hosted API (e.g. the Vercel container).
# No trailing slash, and rebuild after changing it: Vite bakes this in at build time.
# VITE_API_BASE_URL=https://aijentix-api.vercel.app
